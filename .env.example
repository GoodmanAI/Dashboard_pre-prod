# --- Pilot, CRM interne, et espaces (plan lyrae/plans/2026-11-pilot-dans-le-dashboard.md) ---
# Hôte de Pilot (défaut : pilote.dashboard.neuracorp.ai). En local, pilote.localhost:3000 marche aussi.
PILOT_HOST=
# Cookie de session partagé avec Pilot. Prod : dashboard.neuracorp.ai. Vide en local (cookie lié à l'hôte).
AUTH_COOKIE_DOMAIN=
# Adresses publiques, inlinées au build. Vides en local : Pilot reste sur localhost:3000/pilot.
NEXT_PUBLIC_PILOT_URL=
NEXT_PUBLIC_DASHBOARD_URL=
# 1 ou absente : géocodage des centres (data.geopf.fr) ; 0 : coupé.
PILOT_GEOCODAGE=
# 1 ou absente : annuaire public des entreprises ; 0 : coupé.
PILOT_ANNUAIRE=
# E-mail du compte au nom duquel agissent les scripts de Pilot (défaut : premier SUPER_ADMIN).
PILOT_COMPTE_SCRIPT=
# Adresse des mails du support pour un compte dont l'identifiant n'est pas une adresse (le compte « admin ») :
# « identifiant=adresse », séparés par des virgules. Ex. : admin=prenom@exemple.fr
PILOT_MAIL_ADRESSES=
