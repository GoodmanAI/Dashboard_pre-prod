/// Ce sur quoi porte un tarif de la grille (lot S). On ajoute des valeurs, on
/// n'en renomme jamais. POURCENTAGE : un taux en pour-mille, sans montant.
enum CrmBaseTarif {
  PAR_SALLE
  PAR_SITE
  PAR_ORGANISATION
  POURCENTAGE
}

/// Unité facturée d'une ligne à l'usage. Les compteurs correspondants sont tenus
