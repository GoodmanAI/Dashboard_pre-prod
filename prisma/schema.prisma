datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum CentreRole {
  ADMIN_USER
  USER
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id          Int         @id @default(autoincrement())
  name        String?
  email       String      @unique
  password    String
  role        Role        @default(CLIENT)
  centreRole  CentreRole?
  isSecretary Boolean     @default(false)

  /// Override granulaire des permissions (chantier 3).
  /// null = acces complet selon le role (comportement historique).
  /// {...} = sous-compte CLIENT avec permissions par page :
  ///   { "ordonnances": "write", "tickets": "read", "stats": "none" }
  /// Ignore pour SUPER_ADMIN / ADMIN (acces total quel que soit le contenu).
  permissions Json?

  /// Tutoriel du client (plan `2026-10-tutoriel-client-talk.md`).
  /// null = jamais ouvert : sommaire visible, visite de bienvenue au premier login.
  /// { "masque": bool, "visite": bool, "chapitres": ["correspondance"] }
  /// Colonne posée par `manual/2026_10_29_premiers_pas.sql`.
  premiersPas Json?

  /// Compteur de version pour la revocation JWT (kick a distance).
  /// Bump = tous les JWT existants du compte deviennent invalides au
  /// prochain refresh (callback jwt les rejette).
  tokenVersion Int @default(0)

  // ---- Sécurité login (Phase 2 auth hardening) ----
  /// Compteur d'échecs consécutifs. Reset à 0 après un login réussi.
  failedLoginAttempts Int       @default(0)
  /// Timestamp jusqu'auquel le compte est bloqué (NULL = pas bloqué).
  /// Set automatiquement après ACCOUNT_LOCK_THRESHOLD échecs.
  lockedUntil         DateTime?

  managerId    Int?
  manager      User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: Cascade)
  managedUsers User[] @relation("UserManager")

  address    String?
  city       String?
  postalCode String?
  country    String?

  userProducts    UserProduct[]
  userNumbers     UserNumber[]
  tickets         Ticket[]         @relation("TicketForUser")
  notifications   Notification[]
  FileSubmission  FileSubmission[]
  createdTickets  Ticket[]         @relation("TicketCreatedBy")
  assignedTickets Ticket[]         @relation("TicketAssignedTo")
  ticketMessages  TicketMessage[]  @relation("TicketMessageAuthor")

  // 👇 this must match the name in ReceivedCalls.center
  receivedCallsAsCenter ReceivedCalls[] @relation("ReceivedCallsCenter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])

  // Pilot (CRM interne), relations inverses sans colonne (plan 2026-11-pilot-dans-le-dashboard)
  organisationsCompte       CrmOrganisation[]            @relation("OrganisationCompte")
  organisationsResponsable  CrmOrganisation[]            @relation("OrganisationResponsable")
  organisationsChefDeProjet CrmOrganisation[]            @relation("OrganisationChefDeProjet")
  evenements                CrmEvenement[]               @relation("EvenementAuteur")
  acquittements             CrmAcquittement[]            @relation("AcquittementAuteur")
  demandesEnvoyees          CrmDemande[]                 @relation("DemandeDemandeur")
  demandesRecues            CrmDemande[]                 @relation("DemandeDestinataire")
  sujetsSupportOuverts      CrmSujetSupport[]            @relation("SujetSupportAuteur")
  messagesSupport           CrmMessageSupport[]          @relation("MessageSupportAuteur")
  comptesEcartes            CrmCompteEcarte[]            @relation("CompteEcarte")
  ecartsDecides             CrmCompteEcarte[]            @relation("CompteEcarteAuteur")
  accesPilot                CrmAccesPilot?               @relation("AccesPilot")
  accesCrees                CrmAccesPilot[]              @relation("AccesCreePar")
  accesModifies             CrmAccesPilot[]              @relation("AccesModifiePar")
  echanges                  CrmEchange[]                 @relation("EchangeAuteur")
  etapes                    CrmEtapeIntegration[]        @relation("EtapeAuteur")
  scenarios                 CrmScenario[]                @relation("ScenarioAuteur")
  propositions              CrmProposition[]             @relation("PropositionAuteur")
  temperaturesForcees       CrmOrganisation[]            @relation("OrganisationTemperatureForcee")
  concurrentsCrees          CrmConcurrent[]              @relation("ConcurrentCreePar")
  relevesConcurrentsCrees   CrmReleveConcurrent[]        @relation("ReleveConcurrentCreePar")
  grillesTarifairesCreees   CrmGrilleTarifaire[]         @relation("GrilleTarifaireCreePar")
  departementCompte         CrmDepartementCompte?        @relation("DepartementCompte")
  commentairesEcrits        CrmCommentaire[]             @relation("CommentaireAuteur")
  commentairesCibles        CrmCommentaire[]             @relation("CommentairePersonneCible")
  commentairesRecus         CrmDestinataireCommentaire[] @relation("CommentaireDestinataire")
  directeurGeneral          CrmDirecteurGeneral?         @relation("DirecteurGeneral")
  directeursDesignes        CrmDirecteurGeneral[]        @relation("DirecteurGeneralModifiePar")
  alertesAttribuees         CrmAttributionAlerte[]       @relation("AttributionAlerteDestinataire")
  attributionsDecidees      CrmAttributionAlerte[]       @relation("AttributionAlerteAuteur")
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String?
  userProducts   UserProduct[]
  FileSubmission FileSubmission[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Pilot (CRM interne), relations inverses sans colonne (plan 2026-11-pilot-dans-le-dashboard)
  centresProduits   CrmCentreProduit[]
  etapes            CrmEtapeIntegration[]
  lignesContrat     CrmLigneContrat[]
  lignesProposition CrmLigneProposition[]
  opportunites      CrmOpportunite[]
  caMensuels        CrmCaMensuel[]
  tarifs            CrmTarif[]
}

model UserProduct {
  id         Int       @id @default(autoincrement())
  userId     Int
  productId  Int
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  /// Version des Module Info Items (chantier 2026-08-05). Bumpee explicitement
  /// dans le code applicatif a chaque CRUD sur un ModuleInfoItem du centre.
  /// Sert de ETag HTTP + payload webhook Azure warm-up.
  moduleInfoVersion DateTime @default(now())

  /// Délai de conservation des appels, en mois (1 à 24, CHECK en base). Passé ce
  /// délai, le job `scripts/db-maintenance/anonymise_appels.sh` vide la
  /// transcription et la donnée patient de `CallConversation`, et la liste des
  /// appels ne les montre plus. Réglé par l'admin seul. Colonne posée par
  /// prisma/migrations/manual/2026_09_28_retention_appels.sql.
  retentionAppelsMois Int @default(3)

  explainDetails LyraeExplainDetails?
  talkDetails    LyraeTalkDetails?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  TalkSettings TalkSettings?

  receivedCalls       ReceivedCalls[]          @relation("UserProductReceivedCalls")
  informationSettings TalkInformationSettings? @relation("TalkInformationSettingsRelation")
  examMappings        ExamMapping[]
  tickets             Ticket[]
  moduleInfoItems     ModuleInfoItem[]

  CallConversations CallConversation[]

  @@unique([userId, productId])

  // Pilot (CRM interne), relations inverses sans colonne (plan 2026-11-pilot-dans-le-dashboard)
  centresCrm   CrmCentreProduit[]
}

model UserNumber {
  id         Int       @id @default(autoincrement())
  userId     Int
  number     String    @unique
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Produit LyraeExplain — RETIRÉ du dashboard le 24/08/2026 : plus aucun écran,
/// aucune route et aucun seed ne l'utilise. Le modèle est CONSERVÉ à dessein :
/// le supprimer d'ici ferait proposer un `DROP TABLE` par `prisma migrate dev`,
/// qui emporterait les métriques des clients historiques. Table et données
/// restent en place, simplement plus lues.
model LyraeExplainDetails {
  id               Int       @id @default(autoincrement())
  userProductId    Int       @unique
  metricsByMonth   Json      @default("[]")
  commentsByMonth  Json      @default("[]")
  metricsUpdatedAt DateTime?

  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)
}

model LyraeTalkDetails {
  id                   Int      @id @default(autoincrement())
  userProductId        Int      @unique
  talkInfoValidated    Boolean? @default(false)
  talkLibelesValidated Boolean? @default(false)

  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)
}

model FileSubmission {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Ticket {
  id            Int          @id @default(autoincrement())
  userId        Int
  createdById   Int?
  userProductId Int?
  assignedToId  Int?
  subject       String
  message       String
  contactEmail  String?
  status        TicketStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  resolvedAt    DateTime?
  closedAt      DateTime?

  user          User            @relation("TicketForUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo    User?           @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  userProduct   UserProduct?    @relation(fields: [userProductId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  notifications Notification[]

  @@index([userProductId, status])
  @@index([assignedToId, status])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  ticketId  Int?
  userId    Int
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Notifications communes au Dashboard et à Pilot (SQL 2026_11_23_notifications_communes.sql).
  /// `type` : ticket, pilot.demande, pilot.commentaire, pilot.alerte. Null = ancien ticket.
  type      String?
  /// Chemin ouvert au clic (/pilot/..., /admin/...). Null : on retombe sur le ticket.
  lien      String?
  /// Clé de déduplication par destinataire : une même cause ne notifie qu'une fois.
  cle       String?

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cle])
}

model TalkSettings {
  id            Int @id @default(autoincrement())
  userProductId Int @unique

  voice               String?
  botName             String?
  welcomeMsg          String?
  emergencyOutOfHours String?
  callMode            String?

  fullPlanningNotes Json  @default("{}")
  examsAccepted     Json? @default("{}")
  examQuestions     Json? @default("{}")

  exams            Json  @default("[]")
  examInstructions Json? @default("{}")

  multiExamMapping Json? @default("{}")
  options          Json?

  specificNotes  String?
  reconnaissance Boolean @default(false)

  centerName String?
  address    String?
  address2   String?

  centerPhone   String?
  centerWebsite String?
  centerMail    String?

  updatedAt DateTime @updatedAt

  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)
}

model ReceivedCalls {
  id            Int      @id @default(autoincrement())
  userProductId Int
  centerId      Int
  createdAt     DateTime @default(now())

  // 👇 Must use the same relation name
  userProduct UserProduct @relation("UserProductReceivedCalls", fields: [userProductId], references: [id], onDelete: Cascade)

  // Relation to User (center)
  center User @relation("ReceivedCallsCenter", fields: [centerId], references: [id], onDelete: Cascade)
}

model TalkInformationSettings {
  id            Int      @id @default(autoincrement())
  userProductId Int      @unique
  data          Json     @default("{}")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  weeklyHours   Json?    @default("{}")

  userProduct UserProduct @relation("TalkInformationSettingsRelation", fields: [userProductId], references: [id], onDelete: Cascade)
}

model ExamMapping {
  id            Int    @id @default(autoincrement())
  userProductId Int
  examCode      String
  fr            String
  labelFr       String
  diminutif     String

  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)

  @@unique([userProductId, examCode])
}

model CallConversation {
  id            Int      @id @default(autoincrement())
  userProductId Int
  centerId      Int
  treated       Boolean  @default(false)
  flagged       Boolean  @default(false)
  steps         Json     @default("{}")
  stats         Json     @default("{}")
  createdAt     DateTime @default(now())

  /// Longueur de `steps` à l'écriture. Les écrans ne comptent que les appels de
  /// plus d'un échange ; `steps` étant vidé à l'anonymisation, c'est cette colonne
  /// qui garde l'information. NULL sur une ligne écrite avant la migration et pas
  /// encore remplie : les lectures retombent alors sur la longueur de `steps`.
  nbTours       Int?
  /// Nombre de lignes du patient non vides, écrit à l'arrivée de l'appel (22/11/2026).
  /// 0 = le patient n'a dit aucun mot : l'appel sort des écrans et des statistiques du
  /// client, compté à part (`src/lib/appelsSansParole.ts`). NULL = inconnu, compté.
  /// Posé par prisma/migrations/manual/2026_11_22_appels_sans_parole.sql.
  nbToursPatient Int?
  /// Posé par le job d'anonymisation : `steps` vidé, `phoneNumber` et `entites`
  /// retirés de `stats`. NULL = la ligne porte encore sa transcription.
  anonymiseeLe  DateTime?
  /// Quand le client a signalé l'appel ; NULL s'il ne l'est pas. Les signalements
  /// d'avant le 28/10/2026 sont datés de l'appel.
  /// Posé par prisma/migrations/manual/2026_10_28_signalement_commente.sql.
  flaggedAt     DateTime?
  /// « Qu'est-ce qui s'est mal passé ? », facultatif. Peut porter une donnée patient :
  /// effacé avec la transcription par anonymise_appels.sh, jamais journalisé.
  flagComment   String?   @db.VarChar(500)

  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)

  // Poses par prisma/migrations/manual/2026_09_18_callconversation_index.sql (CONCURRENTLY,
  // donc hors migration Prisma). Un troisieme index, partiel sur `flagged`, ne s'exprime
  // pas ici et ne vit que dans ce fichier. Idem pour l'index partiel du job
  // d'anonymisation (2026_09_28_retention_appels.sql).
  @@index([userProductId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// FAQ patient editee par le client depuis le dashboard (chantier 2026-08-05).
/// Consommee par la brique Azure Functions module_info via GET public
/// /api/module-info/[userProductId] avec cache invalidation via ETag / 304.
/// Une ligne par Q/R. La version agregee vit sur UserProduct.moduleInfoVersion.
model ModuleInfoItem {
  id            String   @id
  userProductId Int
  question      String
  reponse       String
  categorie     String?
  enabled       Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProduct UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)

  @@index([userProductId, enabled, order])
  @@index([userProductId, categorie])
}

/// Historique des tentatives de connexion (Phase 2 auth hardening).
/// Utilisé pour le rate limiting par IP : > 5 échecs / 15 min → 429.
/// Une ligne par tentative (succès ou échec). Purge : cf. cron ou cleanup.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  email     String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// ===========================================================================
// LYRAE PILOT : CRM interne (src/pilot, src/app/pilot). Tables créées en SQL manuel
// (prisma/migrations/manual/*pilot*.sql), déclarées ici pour le client Prisma.
// Jamais de prisma migrate / db push sur ces tables (docs/pilot/CHOIX.md, C-01).
// ===========================================================================

// ---------------------------------------------------------------------------
// Énumérations
//
// Règle transverse n° 2 de l'écosystème : on ajoute des valeurs, on n'en
// renomme JAMAIS une. Une valeur abandonnée est laissée en place.
// ---------------------------------------------------------------------------

/// Étape commerciale d'une organisation. Les quatre premières sont le couloir
/// commercial, les quatre suivantes la livraison et la vie du client. PERDU et
/// EN_SOMMEIL sont des sorties possibles de n'importe quelle étape commerciale.
enum CrmEtapeCommerciale {
  PROSPECT
  POURPARLERS
  VISIO_TECHNIQUE
  PROPOSITION
  SIGNE
  EN_INTEGRATION
  EN_PRODUCTION
  ARRETE
  PERDU
  EN_SOMMEIL
  EN_POC
  POC_NON_TRANSFORME
}

enum CrmTypeOrganisation {
  GROUPE_PRIVE
  HOPITAL
  GIE
  CABINET
  CLINIQUE
  CHU
}

enum CrmTypeEchange {
  VISIO_POURPARLERS
  VISIO_TECHNIQUE
  DEMO
  MAIL
  APPEL
  DEVIS_ENVOYE
  RELANCE
  JALON
  FORMATION
  VISITE
  /// Branchement au RIS et à la téléphonie, planifié puis confirmé (C-62).
  INTERFACAGE
  /// Message LinkedIn, canal de prospection du tableur des commerciaux (C-65).
  LINKEDIN
}

/// Priorité commerciale d'un prospect (C-65), A+ d'abord. L'ordre sert au tri.
enum CrmPriorite {
  A_PLUS
  A
  B
  C
}

/// Où en est la position d'un centre sur la carte (lot U). A_FAIRE : pas encore
/// cherchée, ou adresse changée depuis. ADRESSE_INCOMPLETE : il manque la rue,
/// ou le code postal et la ville ; rien n'est envoyé au service. AMBIGU : le
/// service hésite, la position la plus probable est gardée. INTROUVABLE : rien
/// de crédible. On ajoute des valeurs, on n'en renomme aucune.
enum CrmGeocodageStatut {
  A_FAIRE
  OK
  AMBIGU
  INTROUVABLE
  ADRESSE_INCOMPLETE
}

enum CrmRaisonSortie {
  PRIX
  CONCURRENT
  PAS_DE_BUDGET
  RIS_INCOMPATIBLE
  TIMING
  SANS_REPONSE
  AUTRE
}

enum CrmAttitude {
  SOUTIEN
  NEUTRE
  OPPOSANT
  INCONNU
}

enum CrmStatutEchange {
  PLANIFIE
  REALISE
  ANNULE
}

/// Types du journal : on ajoute, on ne renomme jamais.
/// Support (25/11/2026, plan lyrae/plans/2026-11-support-dans-pilot.md).
enum CrmStatutSujetSupport {
  OUVERT
  A_TRANSMETTRE
  TRANSMIS
  RESOLU
}

enum CrmTypeEvenement {
  SUPPORT_SUJET_CREE
  SUPPORT_MESSAGE_AJOUTE
  SUPPORT_STATUT_CHANGE
  SUPPORT_RELANCE
  FORMATION_POC_CREEE
  FORMATION_POC_PRIX_RENSEIGNE
  FORMATION_POC_FACTURE_EMISE
  ORGANISATION_CREEE
  ORGANISATION_MODIFIEE
  ETAPE_COMMERCIALE_CHANGEE
  CONTACT_AJOUTE
  CONTACT_MODIFIE
  CONTACT_SUPPRIME
  CENTRE_CREE
  RATTACHEMENT_CREE
  DATE_PROMISE_CHANGEE
  ETAPE_INTEGRATION_COCHEE
  ETAPE_INTEGRATION_DECOCHEE
  ETAPE_INTEGRATION_REGRESSION
  ATTENTE_TIERS_CHANGEE
  ECHANGE_SAISI
  ECHANGE_MODIFIE
  PROCHAINE_ACTION_CHANGEE
  PROPOSITION_CREEE
  PROPOSITION_STATUT_CHANGE
  CONTRAT_CREE
  CONTRAT_MODIFIE
  OPPORTUNITE_CREEE
  OPPORTUNITE_MODIFIEE
  SCENARIO_ENREGISTRE
  ALERTE_ACQUITTEE
  CA_MENSUEL_FIGE
  IMPORT_EXECUTE
  DEMANDE_CREEE
  DEMANDE_TRAITEE
  /// Reprise du parc (C-60) : un compte du Dashboard relié, écarté ou réaffiché.
  COMPTE_REPRIS
  COMPTE_ECARTE
  COMPTE_REAFFICHE
  /// Apport d'affaires (C-63).
  APPORT_CREE
  APPORT_MODIFIE
  APPORT_RETIRE
  FACTURE_APPORT_CHANGEE
  APPORTEURS_MODIFIES
  /// Comptes de l'équipe et droits (C-64).
  COMPTE_CREE
  ACCES_MODIFIE
  ACCES_RETIRE
  ACCES_RENDU
  MOT_DE_PASSE_REINITIALISE
  MOT_DE_PASSE_CHANGE
  /// Concurrents et forçage de la température (lot R). Un événement de
  /// concurrent n'a pas d'organisation : la cible est dans `apres` / `avant`.
  CONCURRENT_CREE
  CONCURRENT_MODIFIE
  CONCURRENT_SUPPRIME
  RELEVE_CONCURRENT_AJOUTE
  RELEVE_CONCURRENT_MODIFIE
  RELEVE_CONCURRENT_SUPPRIME
  TEMPERATURE_FORCEE
  TEMPERATURE_LIBEREE
  /// Grille tarifaire commune et datée (lot S). Un événement de grille n'a pas
  /// d'organisation : la cible est dans `apres` / `avant`.
  GRILLE_TARIFAIRE_CREEE
  GRILLE_TARIFAIRE_MODIFIEE
  TARIF_AJOUTE
  TARIF_MODIFIE
  TARIF_SUPPRIME
  GRILLE_TARIFAIRE_SUPPRIMEE
  /// Commentaires avec alerte et départements (lot T). Le journal porte la cible
  /// et le nombre de destinataires, jamais le texte (C-22, C-27). Un événement
  /// de département n'a pas d'organisation : le compte est dans `apres` / `avant`.
  COMMENTAIRE_ECRIT
  COMMENTAIRE_SUPPRIME
  DEPARTEMENT_MODIFIE
  /// Qui fait quoi (lot X, C-91). Le journal porte le département de la
  /// personne choisie et son identifiant, jamais son nom (C-22).
  ALERTE_ATTRIBUEE
  DIRECTEUR_GENERAL_DESIGNE
  CYCLE_POC_OUVERT
  CYCLE_POC_CLOS
}

/// Le département d'un compte de l'équipe (lot T). Proposés, en attente de
/// validation. On ajoute des valeurs, on n'en renomme jamais.
enum CrmDepartement {
  COMMERCIAL
  PROJET
  TECHNIQUE
  DIRECTION
}

/// Qui un commentaire prévient (lot T). AUCUN : une note sans alerte.
enum CrmCibleCommentaire {
  AUCUN
  TOUS
  DEPARTEMENT
  PERSONNE
}

/// Famille d'un concurrent (lot R). On ajoute des valeurs, on n'en renomme jamais.
enum CrmTypeConcurrent {
  ROBOT_VOCAL
  CENTRE_APPELS
  SECRETARIAT_EXTERNALISE
  EDITEUR_RDV
  AUTRE
}

/// Température d'un dossier, du plus froid au plus chaud (lot R). Seul le
/// forçage humain est stocké ; la température calculée ne l'est jamais (C-08).
enum CrmTemperature {
  FROID
  TIEDE
  CHAUD
}

/// Le rôle d'un compte de l'équipe dans Pilot (C-64). Le super-administrateur
/// reste le rôle SUPER_ADMIN du Dashboard. On ajoute des valeurs, on n'en renomme jamais.
enum CrmProfilPilot {
  DEVELOPPEUR
  GERANT
}

/// Les droits que le super-administrateur coche compte par compte (C-64).
enum CrmDroitPilot {
  VOIR_CA
  EXPORTER_CA
  MODIFIER_MONTANTS
  EVALUER_PARC
}

/// Ce qu'on demande à un collègue de faire (C-58). On ajoute des types, on n'en renomme jamais.
enum CrmTypeDemande {
  RAPPELER_CLIENT
  PLANIFIER_VISIO
  PREPARER_DEVIS
  VALIDER_REMISE
  RELANCER_EDL
  OBTENIR_ACCES_RIS
  FINIR_MAPPING
  PARAMETRER_ROBOT
  TESTER_CRENEAUX
  VERIFIER_TELEPHONIE
  PLANIFIER_FORMATION
  ENVOYER_ACCES_DASHBOARD
  PREPARER_MISE_EN_SERVICE
  AUTRE
}

