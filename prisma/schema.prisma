  OUVERTE
  FAITE
  ANNULEE
}

enum CrmRoleDecision {
  DECIDEUR
  PRESCRIPTEUR
  UTILISATEUR
  TECHNIQUE
  INCONNU
}

/// Les cases de la check-list d'intégration. Une clé par ligne du tableau du
