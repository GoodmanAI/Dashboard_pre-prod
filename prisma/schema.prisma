  PREMIERE_VISIO
  VISIO_TECHNIQUE
  JETON_XPLORE
  CODE_CENTRE
  MAPPING_EXAMENS
  REGLAGES_ROBOT
  INTERFACAGE_TELEPHONIQUE
  INTEGRATION_SITE_WEB
  FORMATION_SECRETAIRES
  PREMIER_APPEL_REEL
  PASSAGE_PRODUCTION
  ACCES_DASHBOARD_ENTRAINEMENT
  FORMATION_DASHBOARD
  TEST_CRENEAUX
  MESSAGES_RAPPEL
  PREMIER_RAPPEL
  /// Lot V (C-85) : la checklist de déploiement du 06/11/2026.
  PASSATION
  PRECADRAGE_INTERNE
  PARCOURS_PATIENT
  CONTACTS_FACTURATION
  RESPONSABLE_DESIGNE
  LISTE_ELEMENTS
  REGLES_EXAMENS
  LECTURE_ORDONNANCE
  MESSAGES_PATIENTS
  FORMATION_CONFIRMEE
  DATE_DEMARRAGE_CONFIRMEE
  PV_RECETTE
  TOP_FACTURATION
  SUIVI_J1
  SUIVI_S1
  BILAN_M1
  ESSAI_VALIDE
  BON_COMMANDE_EDL
}

